#!/bin/sh
# Thin autotools-style wrapper around CMake so the usual
# `./configure && make && make check && make distcheck` flow works.
#
# Usage: ./configure [--prefix=DIR] [--build-type=TYPE] [--builddir=DIR]

set -e

srcdir=$(cd "$(dirname "$0")" && pwd)
prefix=/usr/local
build_type=Release
builddir=build

for arg in "$@"; do
    case "$arg" in
        --prefix=*)     prefix=${arg#*=} ;;
        --build-type=*) build_type=${arg#*=} ;;
        --builddir=*)   builddir=${arg#*=} ;;
        -h|--help)
            sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "configure: unknown option: $arg" >&2
            exit 1
            ;;
    esac
done

command -v cmake >/dev/null 2>&1 || {
    echo "configure: error: cmake not found" >&2
    exit 1
}

printf 'checking for wiringPi.h... '
if printf '#include <wiringPi.h>\nint main(void){return 0;}\n' \
        | ${CC:-cc} -x c - -o /dev/null -lwiringPi >/dev/null 2>&1; then
    echo yes
else
    echo no
    echo "configure: error: wiringPi headers/library not found" >&2
    exit 1
fi

cmake -S "$srcdir" -B "$builddir" \
    -DCMAKE_BUILD_TYPE="$build_type" \
    -DCMAKE_INSTALL_PREFIX="$prefix"

cat > Makefile <<EOF
# Generated by configure -- do not edit.
SRCDIR   = $srcdir
BUILDDIR = $builddir
DISTNAME = RPi-Buzzer-Example

.PHONY: all check install clean distclean dist distcheck

all:
	cmake --build \$(BUILDDIR)

check: all
	cd \$(BUILDDIR) && ctest --output-on-failure

install: all
	cmake --install \$(BUILDDIR)

clean:
	cmake --build \$(BUILDDIR) --target clean

distclean:
	rm -rf \$(BUILDDIR) Makefile \$(DISTNAME).tar.gz

dist:
	git -C \$(SRCDIR) archive --format=tar.gz --prefix=\$(DISTNAME)/ -o \$(CURDIR)/\$(DISTNAME).tar.gz HEAD

distcheck: dist
	rm -rf _distcheck && mkdir _distcheck
	tar -xzf \$(DISTNAME).tar.gz -C _distcheck
	cd _distcheck/\$(DISTNAME) && ./configure && \$(MAKE) && \$(MAKE) check
	rm -rf _distcheck
	@echo "\$(DISTNAME).tar.gz is ready for distribution"
EOF

echo "configure: wrote Makefile (build dir: $builddir)"
